(version 1)
# Generated by pcb-house-rules (Electronic Cats rules, 4-layer, stackup JLC04161H-7628).
# Regenerate instead of editing: python3 apply_rules.py <project>

# ---- JLCPCB standard capabilities (no surcharge) ----
(rule "JLC min track" (constraint track_width (min 0.09mm)))
(rule "JLC min clearance" (constraint clearance (min 0.09mm)))
(rule "JLC min via hole" (condition "A.Type == 'Via'") (constraint hole_size (min 0.2mm)))
(rule "JLC annular ring" (condition "A.Type == 'Via'") (constraint annular_width (min 0.13mm)))
(rule "JLC copper to edge" (constraint edge_clearance (min 0.3mm)))
(rule "JLC silkscreen legibility" (severity warning) (layer "F.Silkscreen") (constraint text_thickness (min 0.15mm)) (constraint text_height (min 1.0mm)))
(rule "JLC silkscreen legibility bottom" (severity warning) (layer "B.Silkscreen") (constraint text_thickness (min 0.15mm)) (constraint text_height (min 1.0mm)))

# ---- Electronic Cats rules ----
(rule "House via size" (condition "A.Type == 'Via'") (constraint via_diameter (min 0.6mm)) (constraint hole_size (min 0.3mm)))
(rule "House copper to edge" (constraint edge_clearance (min 0.5mm)))
(rule "House hole to hole" (constraint hole_to_hole (min 0.25mm)))
(rule "House power width" (severity warning) (condition "A.NetClass == 'Power' || A.NetClass == 'GND'") (constraint track_width (min 0.3mm)))
